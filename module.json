{
  "id": "pf1-lighting",
  "title": "PF1 Lighting",
  "description": "Observer-relative light levels for Pathfinder 1e: five brightness tiers, darkness-spell semantics, and a queryable lighting model.",
  "authors": [
    {
      "name": "Hamilcarbarcas"
    }
  ],
  "version": "0.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/readout.css",
    "styles/config.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
