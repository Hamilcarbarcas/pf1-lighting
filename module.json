    }
  },
  "relationships": {
    "systems": [
      {
        "id": "pf1",
        "type": "system",
        "compatibility": {
          "minimum": "11"
        }
      }
    ]
  },
  "url": "https://github.com/Hamilcarbarcas/pf1-lighting",
